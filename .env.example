# ===========================
# 猫叔的教学研究室 — 环境变量
# ===========================

# 数据库
DATABASE_URL=file:./data/maolab.db

# LLM API（必填）
OPENAI_API_KEY=sk-your-key-here

# LLM 模型（可选，默认 gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini

# LLM Base URL（可选，用于 OpenAI 兼容的第三方接口）
OPENAI_BASE_URL=https://api.openai.com

# 课程事实核查后的自动修正轮数（可选，默认 2；成本保护范围 0-3）
MAOLAB_FACT_REPAIR_MAX_ATTEMPTS=2

# 图片生成与 Cowart 标注修改（可选；未配置时普通生图会回退，标注修改不可用）
OPENAI_IMAGE_API_KEY=sk-your-image-key-here
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# 课堂语音（至少配置一个提供商；未点击“启动语音”时不会产生请求）
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
# 自定义/克隆音色必须在服务端显式登记，多个 ID 用英文逗号分隔。
TTS_ALLOWED_VOICE_IDS=
# 设为 1 才把课程教学语气映射为提供商支持的韵律；默认关闭，角色音色始终不变。
TTS_ENABLE_EMOTION=0
# 设为 0 可禁止提供商切换或 Windows 本地回退，以严格保持指定声线。
TTS_ALLOW_PROVIDER_FALLBACK=1
TTS_ALLOW_LOCAL_FALLBACK=1

# tldraw 商用部署许可证（localhost 开发可留空，生产环境需按 tldraw 许可配置）
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# 只读 K12 教育资源库（教材图、地图、学科符号和来源记录）
# 本机标准位置可自动发现；部署或移动目录后显式配置。
MAOLAB_EDUCATION_RESOURCES_ROOT=E:\CC\education-resources\maolab-k12-2026-08-21

# Node 环境
NODE_ENV=development
