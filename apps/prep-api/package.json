{
  "name": "@maolab/prep-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:build": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "e2e:prep": "tsx scripts/prep-e2e.ts",
    "stack:prep": "tsx scripts/prep-stack.ts",
    "package:keygen": "tsx scripts/package-keygen.ts"
  },
  "dependencies": {
    "@agentia/auth-node": "file:../../../maolab-core/packages/agentia-auth-node",
    "@maolab-core/auth": "file:../../../maolab-core/packages/auth",
    "@maolab-core/course-package": "file:../../../maolab-core/packages/course-package",
    "@maolab-core/knowledge": "file:../../../maolab-core/packages/knowledge",
    "@maolab-core/types": "file:../../../maolab-core/packages/types",
    "@maolab/course": "workspace:*",
    "@maolab/domain": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependenciesMeta": {
    "@agentia/auth-node": {
      "injected": true
    },
    "@maolab-core/auth": {
      "injected": true
    },
    "@maolab-core/course-package": {
      "injected": true
    },
    "@maolab-core/knowledge": {
      "injected": true
    },
    "@maolab-core/types": {
      "injected": true
    }
  }
