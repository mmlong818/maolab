{
  "name": "@maolab/render-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "drain": "tsx scripts/drain-queue.ts",
    "e2e:local": "tsx scripts/e2e-local.ts",
    "panel-smoke": "tsx scripts/prep-panel-smoke.ts"
  },
  "dependencies": {
    "@maolab-core/course-package": "file:../../../maolab-core/packages/course-package",
    "@maolab-core/knowledge": "file:../../../maolab-core/packages/knowledge",
    "@maolab-core/types": "file:../../../maolab-core/packages/types",
    "@maolab/course": "workspace:*",
    "@maolab/domain": "workspace:*",
    "pg": "^8.16.3",
    "playwright-core": "1.51.1",
    "pptxgenjs": "4.0.1",
    "tsx": "^4.20.3"
  },
  "dependenciesMeta": {
    "@maolab-core/course-package": {
      "injected": true
    },
    "@maolab-core/knowledge": {
      "injected": true
    },
    "@maolab-core/types": {
      "injected": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^16.4.5",
    "jszip": "3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
